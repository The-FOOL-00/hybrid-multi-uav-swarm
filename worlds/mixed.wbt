#VRML_SIM R2025a utf8
# World 4: Mixed - Commercial and residential blend
# ENU: Z=Up, X=East, Y=North

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Grass.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/road/protos/Road.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/road/protos/RoadIntersection.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Pavement.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/SimpleBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/CommercialBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/ResidentialBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/ModernHouse.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/OldResidentialBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/SmallResidentialBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/RandomBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/SimpleTree.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/StreetLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/TrafficLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/tesla/TeslaModel3Simple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/bmw/BmwX5Simple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"
EXTERNPROTO "../protos/Bird.proto"

WorldInfo {
  info [
    "Multi-UAV Surveillance Research Environment"
    "STIRS-2025 Project - SSN College of Engineering"
    "Scenario: Mixed Commercial and Residential"
  ]
  title "Smart City UAV Surveillance - Mixed"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  gravity -9.806
  CFM 0.00001
  ERP 0.2
}

Viewpoint {
  orientation -0.16 0.22 0.96 1.32
  position 60 -60 55
  near 0.5
  follow "UAV_0"
  followSmoothness 0.5
}

TexturedBackground {
  texture "noon_cloudy_countryside"
  luminosity 1.2
}
TexturedBackgroundLight {
  castShadows FALSE
}

# ── GROUND (asphalt main, grass sides) ───────────────────
Floor {
  size 180 180
  tileSize 4 4
  appearance Asphalt {
  }
}
# Grass park zone (SW corner)
DEF PARK_GROUND Solid {
  translation -55 -55 0.005
  children [
    Shape {
      appearance Grass {
      }
      geometry Box {
        size 50 50 0.01
      }
    }
  ]
  name "park_grass"
  locked TRUE
}

# ── MAIN STREET ───────────────────────────────────────────
Road {
  translation -80 0 0.02
  name "main_street"
  wayPoints [ 0 0 0, 160 0 0 ]
  width 9
  numberOfLanes 3
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}
# Cross streets
Road {
  translation -30 -80 0.02
  rotation 0 0 1 1.5708
  name "cross_w"
  wayPoints [ 0 0 0, 160 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
}
Road {
  translation 30 -80 0.02
  rotation 0 0 1 1.5708
  name "cross_e"
  wayPoints [ 0 0 0, 160 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
}
# Residential side roads
Road {
  translation -80 -40 0.02
  name "res_road_s"
  wayPoints [ 0 0 0, 100 0 0 ]
  width 5
  numberOfLanes 2
}
Road {
  translation -80 40 0.02
  name "res_road_n"
  wayPoints [ 0 0 0, 100 0 0 ]
  width 5
  numberOfLanes 2
}

# Intersections
RoadIntersection {
  translation -30 0 0.02
  roadsWidth 7
  startRoads FALSE
  name "isect_w"
}
RoadIntersection {
  translation 30 0 0.02
  roadsWidth 7
  startRoads FALSE
  name "isect_e"
}

# Traffic lights
TrafficLight {
  translation -32 2 0
  name "tl_1"
}
TrafficLight {
  translation 28 2 0
  name "tl_2"
}

# ── COMMERCIAL ZONE (along main street, north side) ───────
CommercialBuilding {
  translation -55 20 0
  name "shop_1"
}
SimpleBuilding {
  translation -35 22 0
  name "shop_2"
  floorNumber 3
  floorHeight 4
  corners [ 10 8, 10 -8, -10 -8, -10 8 ]
  wallType "factory building"
}
SimpleBuilding {
  translation -10 22 0
  name "shop_3"
  floorNumber 2
  floorHeight 4
  corners [ 14 8, 14 -8, -14 -8, -14 8 ]
  wallType "stone wall"
}
SimpleBuilding {
  translation 15 22 0
  name "office_1"
  floorNumber 8
  floorHeight 3.5
  corners [ 10 10, 10 -10, -10 -10, -10 10 ]
  wallType "windowed building"
}
SimpleBuilding {
  translation 40 22 0
  name "office_2"
  floorNumber 10
  floorHeight 3.5
  corners [ 8 12, 8 -12, -8 -12, -8 12 ]
  wallType "blue glass building"
}
SimpleBuilding {
  translation 60 22 0
  name "office_3"
  floorNumber 6
  floorHeight 3.5
  corners [ 10 10, 10 -10, -10 -10, -10 10 ]
  wallType "concrete building"
}
RandomBuilding {
  translation 75 22 0
  name "random_1"
}

# ── RESIDENTIAL ZONE (south side) ─────────────────────────
ModernHouse {
  translation -60 -22 0
  name "res_house_1"
}
OldResidentialBuilding {
  translation -40 -22 0
  name "res_old_1"
}
SmallResidentialBuilding {
  translation -20 -22 0
  name "res_small_1"
}
ResidentialBuilding {
  translation 5 -22 0
  name "res_build_1"
}
ModernHouse {
  translation 35 -22 0
  rotation 0 0 1 3.14159
  name "res_house_2"
}
SimpleBuilding {
  translation 60 -22 0
  name "res_build_2"
  floorNumber 3
  floorHeight 3
  corners [ 12 8, 12 -8, -12 -8, -12 8 ]
  wallType "residential building"
}
SimpleBuilding {
  translation 78 -22 0
  name "res_build_3"
  floorNumber 2
  floorHeight 3.5
  corners [ 8 8, 8 -8, -8 -8, -8 8 ]
  wallType "old house"
}

# ── TREES ─────────────────────────────────────────────────
Pine { translation -80 5 0  name "pine_1" }
Pine { translation -80 -5 0 name "pine_2" }
Pine { translation -60 5 0  name "pine_3" }
Pine { translation -60 -5 0 name "pine_4" }
SimpleTree { translation -50 -40 0 name "tree_1" }
SimpleTree { translation -60 -40 0 name "tree_2" }
SimpleTree { translation -70 -40 0 name "tree_3" }
SimpleTree { translation -50 -55 0 name "tree_4" }
SimpleTree { translation -60 -55 0 name "tree_5" }
SimpleTree { translation -70 -55 0 name "tree_6" }

# ── VEHICLES ──────────────────────────────────────────────
TeslaModel3Simple { translation -50 5 0.31  rotation 0 0 1 0  name "car_1" }
TeslaModel3Simple { translation -20 5 0.31  rotation 0 0 1 0  name "car_2" }
TeslaModel3Simple { translation 10 5 0.31   rotation 0 0 1 0  name "car_3" }
BmwX5Simple       { translation -50 -5 0.31 rotation 0 0 1 3.14159 name "bmw_1" }
BmwX5Simple       { translation -20 -5 0.31 rotation 0 0 1 3.14159 name "bmw_2" }
TeslaModel3Simple { translation 10 -5 0.31  rotation 0 0 1 3.14159 name "car_4" }

# ── PEDESTRIANS (35) ──────────────────────────────────────
Pedestrian { translation -70 5 1.27   name "ped_0"  controllerArgs [ "--trajectory=-70 5, 70 5" "--speed=1.3" ] shirtColor 0.8 0.2 0.2 }
