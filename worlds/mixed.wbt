# ── UAVs ──────────────────────────────────────────────────
DEF UAV_0 Mavic2Pro { translation 0 0 15  name "UAV_0" controller "uav_camera" }
DEF UAV_1 Mavic2Pro { translation 5 0 15  name "UAV_1" controller "uav_camera" }
DEF UAV_2 Mavic2Pro { translation -5 0 15 name "UAV_2" controller "uav_camera" }
DEF UAV_3 Mavic2Pro { translation 3 3 15  name "UAV_3" controller "uav_camera" }
DEF UAV_4 Mavic2Pro { translation -3 3 15 name "UAV_4" controller "uav_camera" }

# ── BIRDS ─────────────────────────────────────────────────
DEF BIRD_0 Bird { translation 25 20 8  name "bird_0" }
DEF BIRD_1 Bird { translation -20 25 7 name "bird_1" color 0.35 0.28 0.18 }
