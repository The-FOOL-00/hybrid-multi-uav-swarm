WorldInfo {
  info [
    "Single-Drone Navigation Development Environment"
    "Based on Downtown Dense Urban scenario"
    "STIRS-2025 Project - SSN College of Engineering"
    "UAV_1-4 removed — single drone baseline + collision avoidance dev"
    "Mission: (-40, 48, 15) -> (50, 48, 15)"
  ]
  title "Single-Drone Navigation — Downtown Dev World"
  gravity -9.806
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
# ── Viewpoint: Chase-cam locked on UAV_0 spawn region ──────────────────────────
# Position is set behind and above the start point (-40, 48, 15) looking east.
# followType "Tracking Shot" makes Webots automatically track UAV_0 as it moves.
# followSmoothness 0.15 gives a tighter, more responsive camera than the default.
DEF MAIN_VIEW Viewpoint {
  orientation -0.35 0.87 0.35 1.28
  position -70 20 35
  near 0.5
  follow "UAV_0"
  followType "Tracking Shot"
  followSmoothness 0.15
}
TexturedBackground {
  texture "noon_cloudy_countryside"
  luminosity 1.2
}
TexturedBackgroundLight {
  castShadows FALSE
}
Floor {
  size 200 200
  tileSize 4 4
  appearance Asphalt {
  }
}
