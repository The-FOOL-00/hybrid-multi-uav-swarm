# ── PEDESTRIANS (sparse, jogging/walking) ────────────────
Pedestrian {
  translation -60 -25 1.27
  name "ped_0"
  controllerArgs [ "--trajectory=-60 -25, 60 -25" "--speed=2.5" ]
  shirtColor 0.9 0.2 0.2
}
Pedestrian {
  translation -40 0 1.27
  name "ped_1"
  controllerArgs [ "--trajectory=-40 0, -40 60, -30 60, -30 0" "--speed=1.0" ]
  shirtColor 0.2 0.6 0.9
}
Pedestrian {
  translation 0 55 1.27
  name "ped_2"
  controllerArgs [ "--trajectory=0 55, 20 55, 20 40, 0 40" "--speed=1.2" ]
  shirtColor 0.4 0.8 0.3
}
Pedestrian {
  translation 50 -40 1.27
  name "ped_3"
  controllerArgs [ "--trajectory=50 -40, 50 -20, 40 -10, 30 -20" "--speed=1.5" ]
  shirtColor 0.8 0.6 0.1
}
Pedestrian {
  translation -20 -50 1.27
  name "ped_4"
