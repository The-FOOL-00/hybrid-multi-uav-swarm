EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/SimpleBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/ModernHouse.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/SuburbanHouse.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/SimpleTree.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/Forest.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/street_furniture/protos/Bench.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/StreetLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/tesla/TeslaModel3Simple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"
EXTERNPROTO "../protos/Bird.proto"

WorldInfo {
  info [
    "Multi-UAV Surveillance Research Environment"
    "STIRS-2025 Project - SSN College of Engineering"
    "Scenario: Residential Neighborhood"
  ]
  title "Smart City UAV Surveillance - Residential"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  gravity -9.806
  CFM 0.00001
  ERP 0.2
}

Viewpoint {
  orientation -0.16 0.22 0.96 1.32
  position 50 -50 45
  near 0.5
  follow "UAV_0"
  followSmoothness 0.5
}

TexturedBackground {
  texture "noon_cloudy_countryside"
  luminosity 1.3
}
TexturedBackgroundLight {
  castShadows FALSE
}

# ── GROUND (grass) ────────────────────────────────────────
Floor {
  size 160 160
  tileSize 6 6
  appearance Grass {
  }
}

# ── ROADS (curved residential layout) ────────────────────
Road {
  translation -70 -30 0.02
  name "road_main"
  wayPoints [ 0 0 0, 60 0 0, 80 20 0, 100 20 0, 140 0 0 ]
  splineSubdivision 8
  width 5
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
}
Road {
  translation -50 -30 0.02
  rotation 0 0 1 1.5708
  name "road_loop1"
  wayPoints [ 0 0 0, 30 0 0, 60 20 0, 60 40 0, 30 60 0, 0 60 0 ]
  splineSubdivision 8
  width 5
  numberOfLanes 1
}
Road {
  translation -20 10 0.02
  rotation 0 0 1 0.7854
  name "road_side"
  wayPoints [ 0 0 0, 50 0 0 ]
  width 5
  numberOfLanes 1
}

# ── HOUSES (8 residential buildings) ─────────────────────
ModernHouse {
  translation -55 20 0
  name "house_1"
}
ModernHouse {
  translation -30 25 0
  rotation 0 0 1 3.14159
  name "house_2"
}
SuburbanHouse {
  translation 5 20 0
  name "house_3"
}
SuburbanHouse {
  translation 35 20 0
  rotation 0 0 1 3.14159
  name "house_4"
}
SimpleBuilding {
  translation -55 -20 0
  name "house_5"
  floorNumber 2
  floorHeight 3
  corners [ 8 6, 8 -6, -8 -6, -8 6 ]
  wallType "old house"
}
SimpleBuilding {
  translation -30 -20 0
  name "house_6"
  floorNumber 2
  floorHeight 3
  corners [ 7 7, 7 -7, -7 -7, -7 7 ]
  wallType "tall house"
}
SimpleBuilding {
  translation 5 -20 0
  name "house_7"
  floorNumber 2
  floorHeight 3
  corners [ 9 6, 9 -6, -9 -6, -9 6 ]
  wallType "residential building"
}
SimpleBuilding {
  translation 55 10 0
  name "house_8"
  floorNumber 3
  floorHeight 3
  corners [ 8 8, 8 -8, -8 -8, -8 8 ]
  wallType "old house"
}

# ── PARK AREAS with trees ─────────────────────────────────
Forest {
  translation -10 55 -0.01
  shape [ 20 20, 20 -20, -20 -20, -20 20 ]
  density 0.03
  type "cherry tree"
  randomSeed 42
  maxHeight 8
  minHeight 4
  maxRadius 3
  minRadius 2
}
Forest {
  translation 45 -40 -0.01
  shape [ 25 15, 25 -15, -25 -15, -25 15 ]
  density 0.025
  type "birch"
  randomSeed 7
  maxHeight 10
  minHeight 5
  maxRadius 4
  minRadius 2
}

Pine { translation -45 50 0  name "pine_park_1" }
Pine { translation -35 50 0  name "pine_park_2" }
Pine { translation -25 50 0  name "pine_park_3" }
Pine { translation -45 60 0  name "pine_park_4" }
Pine { translation -35 60 0  name "pine_park_5" }
SimpleTree { translation 25 -50 0  name "tree_s1" }
SimpleTree { translation 35 -50 0  name "tree_s2" }
SimpleTree { translation 45 -50 0  name "tree_s3" }
SimpleTree { translation 55 -50 0  name "tree_s4" }

# ── BENCHES in park ───────────────────────────────────────
Bench { translation -30 52 0  name "bench_p1" }
Bench { translation -20 52 0  name "bench_p2" }
Bench { translation 35 -45 0  name "bench_p3" }

# ── STREET LIGHTS ─────────────────────────────────────────
StreetLight { translation -60 -28 0  name "sl_1" }
StreetLight { translation -45 -28 0  name "sl_2" }
StreetLight { translation -30 -28 0  name "sl_3" }
StreetLight { translation -15 -28 0  name "sl_4" }
StreetLight { translation 0 -28 0   name "sl_5" }
StreetLight { translation 20 -28 0  name "sl_6" }

# ── PARKED CARS ───────────────────────────────────────────
