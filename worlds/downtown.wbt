# ── SUPERVISOR ROBOT (moves UAVs via supervisor API) ─────
Robot {
  translation 0 0 0
  name "swarm_supervisor"
  controller "uav_swarm_controller"
  supervisor TRUE
  children [
  ]
  boundingObject NULL
  physics NULL
}
