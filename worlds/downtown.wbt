#VRML_SIM R2025a utf8
# World 1: Downtown - Dense urban environment with grid roads
# Coordinate system: ENU (East=X, North=Y, Up=Z)
# UAVs at Z=15m altitude; pedestrians at Z=1.27m (center of model)

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/road/protos/Road.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/road/protos/RoadIntersection.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Pavement.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/SimpleBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/CommercialBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/ResidentialBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/LargeResidentialTower.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/RandomBuilding.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/Hotel.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/trees/protos/SimpleTree.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/StreetLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/CrossRoadsTrafficLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/TrafficCone.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/street_furniture/protos/Bench.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/street_furniture/protos/BusStop.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/tesla/TeslaModel3Simple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"
EXTERNPROTO "../protos/Bird.proto"

WorldInfo {
  info [
    "Multi-UAV Surveillance Research Environment"
    "STIRS-2025 Project - SSN College of Engineering"
    "Scenario: Downtown Dense Urban"
  ]
  title "Smart City UAV Surveillance - Downtown"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  gravity -9.806
  CFM 0.00001
  ERP 0.2
}

Viewpoint {
  orientation -0.16 0.22 0.96 1.32
  position 60 -60 55
  near 0.5
  follow "UAV_0"
  followSmoothness 0.5
}

TexturedBackground {
  texture "noon_cloudy_countryside"
  luminosity 1.2
}

TexturedBackgroundLight {
  castShadows FALSE
}

# ── GROUND ───────────────────────────────────────────────
Floor {
  size 200 200
  tileSize 4 4
  appearance Asphalt {
  }
}

# ── ROAD GRID 3×3 ─────────────────────────────────────────
# East-West roads (extend along X, at Y=-40, 0, +40)
Road {
  translation -90 -40 0.02
  name "road_ew_s"
  wayPoints [ 0 0 0, 180 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}
Road {
  translation -90 0 0.02
  name "road_ew_c"
  wayPoints [ 0 0 0, 180 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}
Road {
  translation -90 40 0.02
  name "road_ew_n"
  wayPoints [ 0 0 0, 180 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}
# North-South roads (extend along Y after 90° rotation, at X=-40, 0, +40)
Road {
  translation -40 -90 0.02
  rotation 0 0 1 1.5708
  name "road_ns_w"
  wayPoints [ 0 0 0, 180 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}
Road {
  translation 0 -90 0.02
  rotation 0 0 1 1.5708
  name "road_ns_c"
  wayPoints [ 0 0 0, 180 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}
Road {
  translation 40 -90 0.02
  rotation 0 0 1 1.5708
  name "road_ns_e"
  wayPoints [ 0 0 0, 180 0 0 ]
  width 7
  numberOfLanes 2
  rightBorder TRUE
  leftBorder TRUE
  appearance Asphalt {
  }
  pavementAppearance Pavement {
  }
}

