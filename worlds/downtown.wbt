# ── TRAFFIC LIGHTS at key intersections ───────────────────
CrossRoadsTrafficLight {
  translation 0 0 0
  name "tl_center"
}
CrossRoadsTrafficLight {
  translation -40 -40 0
  name "tl_sw"
}
CrossRoadsTrafficLight {
  translation 40 40 0
  name "tl_ne"
}

