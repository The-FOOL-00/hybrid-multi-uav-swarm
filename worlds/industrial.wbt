# ── VEHICLES (industrial trucks/cars) ────────────────────
ToyotaPriusSimple {
  translation -65 -15 0.31
  rotation 0 0 1 0
  name "vehicle_1"
}
ToyotaPriusSimple {
  translation -65 15 0.31
  rotation 0 0 1 0
  name "vehicle_2"
}
ToyotaPriusSimple {
  translation 65 -15 0.31
  rotation 0 0 1 3.14159
  name "vehicle_3"
}

# ── WORKERS (10 pedestrians) ──────────────────────────────
Pedestrian {
  translation -40 -25 1.27
  name "worker_0"
  controllerArgs [ "--trajectory=-40 -25, -40 -15, -20 -15, -20 -25" "--speed=1.0" ]
  shirtColor 0.8 0.6 0.1
}
Pedestrian {
  translation -20 -25 1.27
  name "worker_1"
  controllerArgs [ "--trajectory=-20 -25, 0 -25, 0 -15, -20 -15" "--speed=1.1" ]
  shirtColor 0.8 0.6 0.1
}
Pedestrian {
  translation 0 -25 1.27
