StreetLight { translation -60 -18 0  name "sl_1" }
StreetLight { translation -40 -18 0  name "sl_2" }
StreetLight { translation -20 -18 0  name "sl_3" }
StreetLight { translation 0 -18 0   name "sl_4" }
