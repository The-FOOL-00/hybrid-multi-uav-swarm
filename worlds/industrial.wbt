# ── UAVs ──────────────────────────────────────────────────
DEF UAV_0 Mavic2Pro { translation 0 0 12  name "UAV_0" controller "uav_camera" }
DEF UAV_1 Mavic2Pro { translation 10 0 12 name "UAV_1" controller "uav_camera" }
DEF UAV_2 Mavic2Pro { translation -10 0 12 name "UAV_2" controller "uav_camera" }
DEF UAV_3 Mavic2Pro { translation 0 10 12 name "UAV_3" controller "uav_camera" }
DEF UAV_4 Mavic2Pro { translation 0 -10 12 name "UAV_4" controller "uav_camera" }

# ── BIRDS (5) ─────────────────────────────────────────────
DEF BIRD_0 Bird { translation 20 20 8  name "bird_0" }
DEF BIRD_1 Bird { translation -25 30 7 name "bird_1" color 0.35 0.28 0.18 }
DEF BIRD_2 Bird { translation 15 -30 9 name "bird_2" color 0.2 0.2 0.15 }
DEF BIRD_3 Bird { translation -20 -25 8 name "bird_3" color 0.4 0.35 0.25 }
DEF BIRD_4 Bird { translation 30 10 7  name "bird_4" }

# ── SUPERVISOR ────────────────────────────────────────────
Robot {
  translation 0 0 0
  name "swarm_supervisor"
  controller "uav_swarm_controller"
  supervisor TRUE
  children []
  boundingObject NULL
  physics NULL
}
