#VRML_SIM R2025a utf8
# World 5: Industrial - Port/warehouse with containers
# ENU: Z=Up, X=East, Y=North

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/road/protos/Road.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/Warehouse.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/freight/protos/IntermodalContainer.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/traffic/protos/StreetLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/street_furniture/protos/UrbanFence.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/toyota/ToyotaPriusSimple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"
EXTERNPROTO "../protos/Bird.proto"

WorldInfo {
  info [
    "Multi-UAV Surveillance Research Environment"
    "STIRS-2025 Project - SSN College of Engineering"
    "Scenario: Industrial Port with Containers"
  ]
  title "Smart City UAV Surveillance - Industrial"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  gravity -9.806
  CFM 0.00001
  ERP 0.2
}

Viewpoint {
  orientation -0.16 0.22 0.96 1.32
  position 60 -60 50
  near 0.5
  follow "UAV_0"
  followSmoothness 0.5
}

TexturedBackground {
  texture "cloudy"
  luminosity 1.0
}
TexturedBackgroundLight {
  castShadows FALSE
}

# ── GROUND (concrete) ─────────────────────────────────────
Floor {
  size 180 180
  tileSize 5 5
  appearance Asphalt {
  }
}

# ── ROADS (access roads) ──────────────────────────────────
Road {
  translation -80 -20 0.02
  name "road_main"
  wayPoints [ 0 0 0, 160 0 0 ]
  width 8
  numberOfLanes 2
  appearance Asphalt {
  }
}
Road {
  translation -80 20 0.02
  name "road_secondary"
  wayPoints [ 0 0 0, 160 0 0 ]
  width 6
  numberOfLanes 2
  appearance Asphalt {
  }
}
Road {
  translation 0 -80 0.02
  rotation 0 0 1 1.5708
  name "road_vertical"
  wayPoints [ 0 0 0, 160 0 0 ]
  width 6
  numberOfLanes 2
  appearance Asphalt {
  }
}

# ── WAREHOUSES ────────────────────────────────────────────
Warehouse {
  translation -50 50 0
  rotation 0 0 1 1.5708
  name "warehouse_1"
}
Warehouse {
  translation 30 50 0
  rotation 0 0 1 1.5708
  name "warehouse_2"
}

# ── CRANE STRUCTURE (built from Solid/Shape) ──────────────
DEF CRANE_BASE Solid {
  translation 55 -50 5
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.6 0.1
        roughness 0.4
        metalness 0.6
      }
      geometry Box {
        size 3 3 10
      }
    }
  ]
  name "crane_base"
  boundingObject Box { size 3 3 10 }
}
DEF CRANE_ARM Solid {
  translation 55 -35 12
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.6 0.1
        roughness 0.4
        metalness 0.6
      }
      geometry Box {
        size 1.5 35 1.5
      }
    }
  ]
  name "crane_arm"
  boundingObject Box { size 1.5 35 1.5 }
}
DEF CRANE_MAST Solid {
  translation 55 -50 15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.5 0.1
        roughness 0.4
        metalness 0.6
      }
      geometry Box {
        size 1 1 8
      }
    }
  ]
  name "crane_mast"
  boundingObject Box { size 1 1 8 }
}

